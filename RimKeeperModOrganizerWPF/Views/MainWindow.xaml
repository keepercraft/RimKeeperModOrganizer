        <Menu Grid.Row="0" Grid.Column="2" Background="Transparent" HorizontalAlignment="Right">
            <MenuItem Header="{Binding ModsCollection.Count, StringFormat='- {0}'}" HorizontalAlignment="Right" />
        </Menu>
        <Menu Grid.Row="0" Grid.Column="5">
            <MenuItem 
                Header="{Binding GetModConfigStaticLable}" 
                Background="{Binding GetModConfigStaticColor}"
                ToolTipService.InitialShowDelay="0">
                <MenuItem.ToolTip>
                    <ToolTip>
                        <Border Padding="5" Background="{Binding Color}" BorderBrush="Black" BorderThickness="1" CornerRadius="0">
                            <ScrollViewer MaxHeight="{Binding MainWidowSettings.Height, Mode=OneTime}" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ListModsConfigAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}"
                                                   Padding="10,4,20,4" Margin="1"
                                                   Foreground="Black"
                                                   Background="{Binding Color}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </ToolTip>
                </MenuItem.ToolTip>
            </MenuItem>
        </Menu>
        <Menu Grid.Row="0" Grid.Column="5" Background="Transparent" HorizontalAlignment="Right">
            <MenuItem Header="[Save]" Command="{Binding SaveCommand}" />
        </Menu>


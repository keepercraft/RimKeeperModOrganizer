<Window x:Class="RimKeeperModOrganizerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RimKeeperModOrganizerWPF"
        xmlns:vc="clr-namespace:RimKeeperModOrganizerWPF.Views.ValueConverter"
        xmlns:ex="clr-namespace:RimKeeperModOrganizerWPF.Views.Extensions"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"      
        mc:Ignorable="d"
        xmlns:kdg="clr-namespace:KeeperDataGrid;assembly=KeeperDataGrid" 
        xmlns:sdl="http://schemas.sdl.com/xaml"
        Title="RimKeeper - ModOrganizer" 
        Height="{Binding MainWidowSettings.Height, Mode=TwoWay}" 
        Width="{Binding MainWidowSettings.Width, Mode=TwoWay}"
        Left="{Binding MainWidowSettings.Left, Mode=TwoWay}"
        Top="{Binding MainWidowSettings.Top, Mode=TwoWay}"
        >
    <Window.Resources>
        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DataGridStyles.xaml"/>
                <ResourceDictionary Source="/Themes/MultiDragStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ex:CustomDragSource x:Key="CustomDragSource"/>
            <vc:BoolToSLRConverter x:Key="BoolToSLRConverter"/>
            <ex:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <vc:DoubleToDataGridLengthConverter x:Key="DoubleToLengthConverter" />
            <vc:ModIconConverter x:Key="ModIconConverter" />
            <vc:GridLengthConverter x:Key="GridLengthConverter" />
            <BooleanToVisibilityConverter x:Key="BoolVis"/>

            <ContextMenu x:Key="DataGridContextMenu" 
                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Open in Steam"       
                  Command="{Binding OpenSteamLinkCommand}" 
                  CommandParameter="{Binding PlacementTarget.SelectedItem.SteamLink, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource SteamIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open in Browser" 
                  Command="{Binding OpenLinkCommand}" 
                  CommandParameter="{Binding PlacementTarget.SelectedItem.SteamLink, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource InternetIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open in Explorer" 
                  Command="{Binding OpenLinkCommand}" 
                  CommandParameter="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FolderIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Change color" 
                  Command="{Binding ChangeColorCommand}" 
                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource PaletteIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Remove metadata" 
                  Command="{Binding RemoveMetaDataCommand}" 
                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource TrashIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Details" 
                  Command="{Binding ModDetailCommand}" 
                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource GearIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>

            <Style TargetType="DataGridRow" x:Key="DataGridRowStyle">
                <Setter Property="Background" Value="{Binding Data.Color,TargetNullValue=Transparent}"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
                <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
                <!--<Setter Property="Background" Value="{Binding Alerts.Color}"/>-->
                <Setter Property="ToolTip">
                    <Setter.Value>
                        <Border Padding="5" Background="{Binding Alerts.Color}" BorderBrush="Black" BorderThickness="1" CornerRadius="0">
                            <ItemsControl ItemsSource="{Binding Alerts.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" Background="{Binding Color}" TextWrapping="Wrap" Padding="4" Margin="1"  FontWeight="Bold" Foreground="Black" Opacity="1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Alerts.HasAlert}" Value="False">
                        <Setter Property="ToolTip" Value="{x:Null}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Alerts.HasAlert}" Value="True">
                        <Setter Property="Background" Value="{Binding Alerts.Color}"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridCell" x:Key="ModTypeIconsDataGridCellStyle">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Image Height="16" Width="16" HorizontalAlignment="Left"
                                               Source="{Binding Location, Converter={StaticResource ModIconConverter}}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ModIconSelectBoxItemTemplate">
                <Image Height="16"
                    Width="16"
                    HorizontalAlignment="Left"
                    ToolTip="{Binding}"
                    Source="{Binding Converter={StaticResource ModIconConverter}}" />
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding MainWidowSettings.DetailPanelWidth, Converter={StaticResource GridLengthConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="{Binding MainWidowSettings.ConfigModPanelWidth, Converter={StaticResource GridLengthConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GridSplitter Grid.Column="1" Grid.Row="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Gray"
                      ShowsPreview="True"/>
        <GridSplitter Grid.Column="3" Grid.Row="1"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="Gray"
                      ShowsPreview="True"/>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="5"></StatusBar>

        <Menu Grid.Row="0" Grid.ColumnSpan="5" IsEnabled="{Binding IsUIListEnabled}">
            <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
            <MenuItem Header="Mods">
                <MenuItem Header="Import metadata" Command="{Binding LoadMetaDataCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FileIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Reload metadata" Command="{Binding LoadMetaDataCommand}" CommandParameter="reload">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FileIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Export metadata" Command="{Binding SaveMetaDataCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FileIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Export to CSV"   Command="{Binding ModsToCSVCommand}" CommandParameter="{Binding Items}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FileCSVIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="SELECTED MOD" IsEnabled="False" FontWeight="Bold"/>
                <MenuItem Header="Open in Steam" Command="{Binding OpenSteamLinkCommand}" CommandParameter="{Binding SelectedMod.SteamLink}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource SteamIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open in Browser" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding SelectedMod.SteamLink}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource InternetIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open in Explorer" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding SelectedMod.Path}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FolderIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Change color" Command="{Binding ChangeColorCommand}" CommandParameter="{Binding SelectedMod}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource PaletteIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Remove metadata" Command="{Binding RemoveMetaDataCommand}" CommandParameter="{Binding SelectedMod}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource TrashIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Details" Command="{Binding ModDetailCommand}" CommandParameter="{Binding SelectedMod}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource GearIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Loadout">
                <MenuItem Header="Load from Rimworld config" Command="{Binding LoadActiveModlistCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FileDataIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save to Rimworld config" Command="{Binding SaveActiveModlistCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FileDataIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Import from file" Command="{Binding LoadFileActiveModlistCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FileIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Export to file" Command="{Binding SaveFileActiveModlistCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FileIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Export to CSV" Command="{Binding ModsToCSVCommand}" CommandParameter="{Binding ModsConfigCollection}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FileCSVIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Import colors from Rimpy" Command="{Binding LoadRimpyColorsCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource FileDataIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Options" Command="{Binding OptionsCommand}">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource GearIcon}"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="About" Command="{Binding AboutCommand}"/>
            <!--<MenuItem Header="[Test]" Command="{Binding TestCommand}"/>-->
            <!--<MenuItem>
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16">
                            <Path Fill="Black" Data="
                                M8,0 
                                L9.5,5.5 
                                L15.5,5.5 
                                L10.5,9 
                                L12.5,15 
                                L8,11.5 
                                L3.5,15 
                                L5.5,9 
                                L0.5,5.5 
                                L6.5,5.5 
                                Z"/>
                        </Viewbox>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem>
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{StaticResource SteamIcon}" 
                           Width="16" 
                           Height="16" 
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>-->

        </Menu>
        <Menu Grid.Row="0" Grid.Column="2" Background="Transparent" HorizontalAlignment="Right">
            <MenuItem Header="{Binding ModsCollection.Count, StringFormat='- {0}'}" HorizontalAlignment="Right" />
        </Menu>
        <Menu Grid.Row="0" Grid.Column="5">
            <MenuItem 
                Header="{Binding GetModConfigStaticLable}" 
                Background="{Binding GetModConfigStaticColor}"
                ToolTipService.InitialShowDelay="0">
                <MenuItem.ToolTip>
                    <ToolTip>
                        <Border Padding="5" BorderBrush="Black" BorderThickness="1" CornerRadius="0">
                            <ScrollViewer MaxHeight="{Binding MainWidowSettings.Height, Mode=OneTime}" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ListModsConfigAlerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}"
                                                   Padding="10,4,20,4" Margin="1"
                                                   Foreground="Black"
                                                   Background="{Binding Color}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </ToolTip>
                </MenuItem.ToolTip>
            </MenuItem>
        </Menu>
        <Menu Grid.Row="0" Grid.Column="5" Background="Transparent" HorizontalAlignment="Right">
            <MenuItem Header="[Save]" Command="{Binding SaveCommand}" />
        </Menu>

        <!--<ToolBar Grid.Row="0" Grid.ColumnSpan="5">
            <Button Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsUIListEnabled}"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsUIListEnabled}"/>
            <Button Content="Import" Command="{Binding LoadConfigCommand}" IsEnabled="{Binding IsUIListEnabled}"/>
            <Button Content="Export" Command="{Binding SaveConfigCommand}" IsEnabled="{Binding IsUIListEnabled}"/>
            <Button Content="Options" Command="{Binding OptionsCommand}" IsEnabled="{Binding IsUIListEnabled}"/>
            <Button Content="ChangeColor" Command="{Binding ChangeColorCommand}" IsEnabled="{Binding IsUIListEnabled}"/>
            <Button Content="[RimpyLoad]" Command="{Binding RimpyColorLoadCommand}" IsEnabled="{Binding IsUIListEnabled}"/>
            <Button Content="[CSV]" Command="{Binding ModsToCSVCommand}" IsEnabled="{Binding IsUIListEnabled}"/>
            <Button Content="[TEST]" Command="{Binding TestCommand}" IsEnabled="{Binding IsUIListEnabled}"/>
            <TextBlock Text="{Binding GetModConfigStaticLable}" Padding="5" Background="{Binding GetModConfigStaticColor}" >
                <TextBlock.ToolTip>
                    <ToolTip>
                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ListModsConfigAlert}"/>
                        </ScrollViewer>
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
        </ToolBar>-->

        <kdg:AdvancedFilterDataGrid Grid.Column="2" Grid.Row="1" x:Name="ModsGrid" 
                CellStyle="{StaticResource DataGridSelectionCellStyle}"      
                RowStyle="{StaticResource DataGridRowStyle}"      
                ContextMenu="{StaticResource DataGridContextMenu}"                   
                IsEnabled="{Binding IsUIListEnabled}"          
                ItemsSource="{Binding ModsCollection}"
                ColumnsConfig="{Binding ModsCollectionColumns}"                           
                SelectedItem="{Binding SelectedMod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                dd:DragDrop.IsDragSource="True"
                dd:DragDrop.IsDropTarget="True"     
                dd:DragDrop.DropHandler="{Binding}"      
                dd:DragDrop.UseDefaultDragAdorner="True"     
                dd:DragDrop.DragAdornerTemplate="{StaticResource MultiDragStyle}"    
                dd:DragDrop.DragMouseAnchorPoint="0, 0" 
                dd:DragDrop.DragAdornerTranslation="15, 15" 
                dd:DragDrop.DragHandler="{StaticResource CustomDragSource}"                    
                IsReadOnly="True"
                SelectionMode="Extended"
                CanUserAddRows="False"   
                CanUserSortColumns="True"
                AutoGenerateColumns="False"
                EnableRowVirtualization="True"
                EnableColumnVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.HorizontalScrollBarVisibility="Visible" 
                ScrollViewer.VerticalScrollBarVisibility="Visible"                       
            >
            <kdg:AdvancedFilterDataGrid.Columns>

                <kdg:FilterableTextColumn ShowFilter="Collapsed" ShowSelectBoxFilter="Visible" 
                    Key="type"                      
                    Width="20" Header="" MaxWidth="42"
                    CellStyle="{StaticResource ModTypeIconsDataGridCellStyle}"   
                    SelectBoxItemTemplate="{StaticResource ModIconSelectBoxItemTemplate}"                      
                    SelectBoxFilterList="{Binding Data.ModTypeIconsList, Source={StaticResource Proxy}, Mode=OneWay}"                      
                    Binding="{Binding Location}"
                />

                <kdg:FilterableTextColumn              
                    Binding="{Binding Label}" 
                    Key="label"
                    Header="Label"    
                    Width="*"
                />
                <kdg:FilterableTextColumn
                    Binding="{Binding About.Authors}"
                    Key="author"                      
                    Header="Author"
                />
                <kdg:FilterableTextColumn
                    Binding="{Binding Data.Group, Mode=OneWay}" 
                    Key="group"                      
                    Header="Group"                  
                />
                <kdg:FilterableTextColumn
                    Binding="{Binding About.PackageId}" 
                    Key="packageid"                      
                    Header="PackageId"                  
                />
                <kdg:FilterableTextColumn
                    Binding="{Binding Versions}" 
                    Key="versions"                      
                    Header="Versions"                  
                />
            </kdg:AdvancedFilterDataGrid.Columns>
        </kdg:AdvancedFilterDataGrid>

        <kdg:AdvancedFilterDataGrid Grid.Column="4" Grid.Row="1" x:Name="ModsGridConfig"
                CellStyle="{StaticResource DataGridSelectionCellStyle}"   
                RowStyle="{StaticResource DataGridRowStyle}"                        
                ContextMenu="{StaticResource DataGridContextMenu}"                                   
                IsEnabled="{Binding IsUIListEnabled}"
                ItemsSource="{Binding ModsConfigCollection}"           
                SelectedItem="{Binding SelectedMod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"                             
                dd:DragDrop.IsDragSource="True"
                dd:DragDrop.IsDropTarget="True"     
                dd:DragDrop.DropHandler="{Binding}"      
                dd:DragDrop.UseDefaultDragAdorner="True"     
                dd:DragDrop.DragAdornerTemplate="{StaticResource MultiDragStyle}"    
                dd:DragDrop.DragMouseAnchorPoint="0, 0" 
                dd:DragDrop.DragAdornerTranslation="15, 15" 
                IsReadOnly="True"                    
                SelectionMode="Extended"
                CanUserAddRows="False"   
                CanUserReorderColumns="False"                    
                CanUserSortColumns="False"
                AutoGenerateColumns="False"
                EnableRowVirtualization="True"
                EnableColumnVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.HorizontalScrollBarVisibility="Visible" 
                ScrollViewer.VerticalScrollBarVisibility="Visible"   
            >
            <kdg:AdvancedFilterDataGrid.Columns>
                <kdg:FilterableTextColumn ShowFilter="Collapsed" ShowSelectBoxFilter="Visible" 
                    Width="20" Header="" MaxWidth="42"
                    CellStyle="{StaticResource ModTypeIconsDataGridCellStyle}"    
                    SelectBoxItemTemplate="{StaticResource ModIconSelectBoxItemTemplate}"                         
                    SelectBoxFilterList="{Binding Data.ModTypeIconsList, Source={StaticResource Proxy}, Mode=OneWay}"                      
                    Binding="{Binding Location}"
                />

                <kdg:FilterableTextColumn Width="*" Header="Nazwa" Binding="{Binding Label}" />
                <!--<DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="40"/>-->

            </kdg:AdvancedFilterDataGrid.Columns>
        </kdg:AdvancedFilterDataGrid>

        <ScrollViewer Grid.Column="0" Grid.Row="1" Padding="10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel.Resources>
                    <Style TargetType="TextBox" x:Key="BaseTextBoxStyle">
                        <Setter Property="Padding" Value="3"/>
                        <Setter Property="IsReadOnly" Value="True"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxStyle}"/>
                </StackPanel.Resources>

                <Image Source="{Binding SelectedMod.ThumbnailPath,TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="Uniform" Margin="0,0,0,10" MaxHeight="300"/>

                <TextBox Text="{Binding SelectedMod.Label,Mode=OneWay}" FontWeight="Bold" FontSize="18" Cursor="Hand">
                    <TextBox.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                            Command="{Binding ModDetailCommand}"
                            CommandParameter="{Binding SelectedMod}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Text="Groups:" FontWeight="Bold"/>
                <sdl:MultiSelectComboBox 
                    x:Name="MyMultiSelect"
                    ItemsSource="{Binding ModGroups}"
                    SelectedItems="{Binding SelectedMod.Data.Groups}"
                    KeyDown="MultiSelect_KeyDown"
                    IsEditable="True"
                    HorizontalAlignment="Stretch"
                    EnableFiltering="True"
                    SelectionMode="Multiple">
                    <sdl:MultiSelectComboBox.Resources>
                        <Style TargetType="TextBox">
                            <Setter Property="IsReadOnly" Value="False"/>
                        </Style>
                    </sdl:MultiSelectComboBox.Resources>
                </sdl:MultiSelectComboBox>

                <TextBlock Text="Comment:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.Data.Comment, Mode=TwoWay}" 
                    IsReadOnly="False"
                    TextWrapping="Wrap" 
                    AcceptsReturn="True"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="5"/>

                <TextBlock Text="ModID Key:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.ModId ,Mode=OneWay}"/>

                <TextBlock Text="Author:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.About.Authors,Mode=OneWay}"/>
                <TextBlock Text="PackageId:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.About.PackageId,Mode=OneWay}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMod.About.PackageIdAutogen}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="ToolTip" Value="Auto-generated PackageId (unstable)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="SteamId:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.About.SteamId,Mode=OneWay}"/>
                <TextBlock Text="SupportedVersions:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.Versions,Mode=OneWay}"/>
                <TextBlock Text="Path:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.Path,Mode=OneWay}" Cursor="Hand">
                    <TextBox.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding SelectedMod.Path}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Url:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.About.Url,Mode=OneWay}" Cursor="Hand">
                    <TextBox.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding SelectedMod.About.Url}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Text="ModDependencies:" FontWeight="Bold" Margin="0,5,0,0"/>
                <ItemsControl ItemsSource="{Binding SelectedMod.About.ModDependencies}" >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Path=., 
                                StringFormat='• {0}', 
                                Mode=OneWay,
                                TargetNullValue='•', 
                                FallbackValue='•'}" 
                                IsReadOnly="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="LoadAfter:" FontWeight="Bold" Margin="0,5,0,0"/>
                <ItemsControl ItemsSource="{Binding SelectedMod.About.LoadAfter}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Path=., 
                                StringFormat='• {0}', 
                                Mode=OneWay,
                                TargetNullValue='•', 
                                FallbackValue='•'}" 
                                IsReadOnly="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="LoadBefore:" FontWeight="Bold" Margin="0,5,0,0"/>
                <ItemsControl ItemsSource="{Binding SelectedMod.About.LoadBefore}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Path=., 
                                StringFormat='• {0}', 
                                Mode=OneWay,
                                TargetNullValue='•', 
                                FallbackValue='•'}" 
                                IsReadOnly="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="IncompatibleWith:" FontWeight="Bold" Margin="0,5,0,0"/>
                <ItemsControl ItemsSource="{Binding SelectedMod.About.IncompatibleWith}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Path=., 
                                StringFormat='• {0}', 
                                Mode=OneWay,
                                TargetNullValue='•', 
                                FallbackValue='•'}" 
                                IsReadOnly="True" Foreground="Red"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Description:" FontWeight="Bold" Margin="0,5,0,0"/>
                <TextBox Text="{Binding SelectedMod.About.Description}" TextWrapping="Wrap" Margin="0,0,0,10"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
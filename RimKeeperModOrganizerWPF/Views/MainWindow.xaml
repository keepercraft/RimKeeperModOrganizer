                        <Setter Property="Padding" Value="3"/>
                        <Setter Property="IsReadOnly" Value="True"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
                    </Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxStyle}"/>
                </StackPanel.Resources>

                <Image Source="{Binding SelectedMod.ThumbnailPath,TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="Uniform" Margin="0,0,0,10" MaxHeight="300"/>

                <TextBox Text="{Binding SelectedMod.Label,Mode=OneWay}" FontWeight="Bold" FontSize="18" Cursor="Hand">
                    <TextBox.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                            Command="{Binding ModDetailCommand}"
                            CommandParameter="{Binding SelectedMod}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Text="Groups:" FontWeight="Bold"/>
                <sdl:MultiSelectComboBox 
                    x:Name="MyMultiSelect"
                    ItemsSource="{Binding ModGroups}"
                    SelectedItems="{Binding SelectedMod.Data.Groups}"
                    KeyDown="MultiSelect_KeyDown"
                    IsEditable="True"
                    HorizontalAlignment="Stretch"
                    EnableFiltering="True"
                    SelectionMode="Multiple">
                    <sdl:MultiSelectComboBox.Resources>
                        <Style TargetType="TextBox">
                            <Setter Property="IsReadOnly" Value="False"/>
                        </Style>
                    </sdl:MultiSelectComboBox.Resources>
                </sdl:MultiSelectComboBox>

                <TextBlock Text="Comment:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.Data.Comment, Mode=TwoWay}" 
                    IsReadOnly="False"
                    TextWrapping="Wrap" 
                    AcceptsReturn="True"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Padding="5"/>

                <TextBlock Text="ModID Key:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.ModId ,Mode=OneWay}"/>

                <TextBlock Text="Author:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.About.Authors,Mode=OneWay}"/>
                <TextBlock Text="PackageId:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.About.PackageId,Mode=OneWay}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMod.About.PackageIdAutogen}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="ToolTip" Value="Auto-generated PackageId (unstable)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="SteamId:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.About.SteamId,Mode=OneWay}"/>
                <TextBlock Text="SupportedVersions:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.Versions,Mode=OneWay}"/>
                <TextBlock Text="Path:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.Path,Mode=OneWay}" Cursor="Hand">
                    <TextBox.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding SelectedMod.Path}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Url:" FontWeight="Bold"/>
                <TextBox Text="{Binding SelectedMod.About.Url,Mode=OneWay}" Cursor="Hand">
                    <TextBox.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding SelectedMod.About.Url}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <!--<TextBlock>
                    <ItemsControl ItemsSource="{Binding SelectedMod.About.SupportedVersions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="0,0,5,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </TextBlock>-->

                <TextBlock Text="ModDependencies:" FontWeight="Bold" Margin="0,5,0,0"/>
                <ItemsControl ItemsSource="{Binding SelectedMod.About.ModDependencies}" >
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Path=., 
                                StringFormat='• {0}', 
                                Mode=OneWay,
                                TargetNullValue='•', 
                                FallbackValue='•'}" 
                                IsReadOnly="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="LoadAfter:" FontWeight="Bold" Margin="0,5,0,0"/>
                <ItemsControl ItemsSource="{Binding SelectedMod.About.LoadAfter}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Path=., 
                                StringFormat='• {0}', 
                                Mode=OneWay,
                                TargetNullValue='•', 
                                FallbackValue='•'}" 
                                IsReadOnly="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="LoadBefore:" FontWeight="Bold" Margin="0,5,0,0"/>
                <ItemsControl ItemsSource="{Binding SelectedMod.About.LoadBefore}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Path=., 
                                StringFormat='• {0}', 
                                Mode=OneWay,
                                TargetNullValue='•', 
                                FallbackValue='•'}" 
                                IsReadOnly="True" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="IncompatibleWith:" FontWeight="Bold" Margin="0,5,0,0"/>
                <ItemsControl ItemsSource="{Binding SelectedMod.About.IncompatibleWith}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Path=., 
                                StringFormat='• {0}', 
                                Mode=OneWay,
                                TargetNullValue='•', 
                                FallbackValue='•'}" 
                                IsReadOnly="True" Foreground="Red"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Description:" FontWeight="Bold" Margin="0,5,0,0"/>
                <TextBox Text="{Binding SelectedMod.About.Description}" TextWrapping="Wrap" Margin="0,0,0,10"/>                
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

<Window x:Class="RimKeeperModOrganizerWPF.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RimKeeperModOrganizerWPF.Views"
        mc:Ignorable="d"
        Title="RimKeeper - ModOrganizer - About" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="{StaticResource RimworldLogoIcon}"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Height="300" Width="600">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#26000000"  Width="400" Height="400" Margin="-180" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Grid.RowSpan="99" Grid.ColumnSpan="99">
            <Border.OpacityMask>
                <ImageBrush ImageSource="{StaticResource RimworldLogoIcon}"/>
            </Border.OpacityMask>
        </Border>

        <DockPanel Grid.Row="0" HorizontalAlignment="Left">
            <Border Background="#FF00375A" Width="40" Height="40" Margin="5,0">
                <Border.OpacityMask>
                    <ImageBrush ImageSource="{StaticResource RimworldLogoIcon}"/>
                </Border.OpacityMask>
            </Border>
            <TextBlock Text="RimKeeper Mod Organizer" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,0" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="IsReadOnly" Value="True"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Authors:" HorizontalAlignment="Right"
                       FontWeight="SemiBold" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Authors,Mode=OneWay}" 
                       VerticalAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Copyright:" HorizontalAlignment="Right"
                       FontWeight="SemiBold" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Copyright,Mode=OneWay}" 
                       VerticalAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Description:" HorizontalAlignment="Right"
                       FontWeight="SemiBold" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding Description,Mode=OneWay}" 
                       VerticalAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Repository:" HorizontalAlignment="Right"
                       FontWeight="SemiBold" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Text="{Binding GitHubUrl,Mode=OneWay}" Cursor="Hand">
                <TextBox.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                        Command="{Binding OpenLinkCommand}"
                        CommandParameter="{Binding GitHubUrl}"/>
                </TextBox.InputBindings>
            </TextBox>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Support:" HorizontalAlignment="Right"
                       FontWeight="SemiBold" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBox   Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Text="{Binding SupportPage,Mode=OneWay}" Cursor="Hand">
                <TextBox.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                        Command="{Binding OpenLinkCommand}"
                        CommandParameter="{Binding SupportPage}"/>
                </TextBox.InputBindings>
            </TextBox>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Version:" HorizontalAlignment="Right"
                       FontWeight="SemiBold" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="6" Grid.Column="1" VerticalAlignment="Center">
                <TextBox Text="{Binding FileVersion,Mode=OneWay}" Foreground="#2980B9"/>
                <TextBlock Text="{Binding ProductVersion,Mode=OneWay}" FontSize="7" Foreground="#27AE60"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>

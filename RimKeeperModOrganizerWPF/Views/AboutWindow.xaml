<Window x:Class="RimKeeperModOrganizerWPF.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RimKeeperModOrganizerWPF.Views"
        mc:Ignorable="d"
        Title="RimKeeper - ModOrganizer - About" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Height="300" Width="600">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="RimKeeper Mod Organizer" 
                   FontSize="18" FontWeight="Bold" Foreground="#333" 
                   Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="TextBox">
                    <Setter Property="IsReadOnly" Value="True"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Version:" 
                       FontWeight="SemiBold" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VersionPrefix}" 
                       VerticalAlignment="Center" Foreground="#2980B9"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Version Tag:" 
                       FontWeight="SemiBold" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VersionSuffix}" 
                       VerticalAlignment="Center" Foreground="#27AE60"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Authors:" 
                       FontWeight="SemiBold" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Authors}" 
                       VerticalAlignment="Center" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Copyright:" 
                       FontWeight="SemiBold" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Copyright}" 
                       VerticalAlignment="Center" TextWrapping="Wrap" FontStyle="Italic"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Repository:" 
                       FontWeight="SemiBold" Margin="0,5,10,5" VerticalAlignment="Center"/>
            <TextBox  Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Text="{Binding GitHubUrl,Mode=OneWay}" Cursor="Hand">
                <TextBox.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding GitHubUrl}"/>
                </TextBox.InputBindings>
            </TextBox>

        </Grid>
    </Grid>
</Window>

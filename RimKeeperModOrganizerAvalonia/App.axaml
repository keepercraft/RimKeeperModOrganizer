<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:RimKeeperModOrganizerAvalonia.Converters"
             xmlns:templates="clr-namespace:ColorPicker.AvaloniaUI.Templates;assembly=ColorPicker.AvaloniaUI"
             x:Class="RimKeeperModOrganizerAvalonia.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <ResourceDictionary>		
			<FontFamily x:Key="InterFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
            <ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="avares://RimKeeperModOrganizerAvalonia/Resources/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="IconBrush" Color="Black"/>
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<SolidColorBrush x:Key="IconBrush" Color="White"/>
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>
            <c:GridLengthConverter x:Key="GridLengthConverter" />
            <c:PathToBitmapConverter x:Key="PathToBitmapConverter" />
			<c:ModIconConverter x:Key="ModIconConverter" />        
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <SimpleTheme />
        <templates:SimpleColorPickerTheme />
		<!--<FluentTheme />
        <templates:PixiPerfectColorPickerTheme />-->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml"/>       
    </Application.Styles>
</Application>
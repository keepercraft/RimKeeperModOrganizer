<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:cp="clr-namespace:ColorPicker;assembly=ColorPicker.AvaloniaUI"
        xmlns:vm="using:RimKeeperModOrganizerAvalonia.ViewModels"
		x:DataType="vm:MainViewModel"
		x:Class="RimKeeperModOrganizerAvalonia.Views.ChangeColorWindow"
        mc:Ignorable="d" 
		Width="400"
        Height="500"
        Title="Wybierz kolor">       
    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">

		<DockPanel x:Name="BtnList" Grid.Row="0" Grid.Column="0">
			<Button Content="Update"
                Width="80"
                Margin="0,0,0,0"
                IsDefault="True"
                Click="List_Update_Click"/>
			<Button Content="X"
                Width="20"
                Margin="0,0,0,0"
                IsDefault="True"
                Click="List_Delete_Click"/>
		</DockPanel>

		<ListBox Grid.Row="1" Grid.Column="0"
            x:Name="ListGroupColors"
            ItemsSource="{Binding ModColors}"
            SelectionChanged="ListBox_SelectionChanged">
			<ListBox.Styles>
				<Style Selector="ListBoxItem">
					<Setter Property="Background" Value="{Binding}"/>
					<Setter Property="Foreground" Value="{Binding Background, RelativeSource={RelativeSource Self}, Converter={StaticResource ContrastTextColorConverter}}"/>
				</Style>
			</ListBox.Styles>
		</ListBox>

		<cp:StandardColorPicker Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                ShowAlpha="False"
                x:Name="StandardColorPicker" />

		<StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
					HorizontalAlignment="Right"
                    Margin="5">
			<Button Content="OK"
                    Width="80"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="Ok_Click"/>
			<Button Content="Anuluj"
                    Width="80"
                    Margin="0,0,10,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
			<Button Content="Clear"
                    Width="80"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="Clear_Click"/>
		</StackPanel>		
    </Grid>
</Window>